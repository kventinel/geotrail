[Unit]
Description=GeoTrail panorama geography game
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/geotrail
Environment=HOST=::
Environment=PORT=8081
ExecStart=/usr/bin/node server.cjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
